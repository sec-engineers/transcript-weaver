{
  "schema_version": 1,
  "logging": {
    "retained_runs": 5
  },
  "providers": {
    "gemini": {
      "model": "gemini-2.5-flash-lite",
      "credential": {
        "source": "pass",
        "name": "api/gemini"
      }
    }
  },
  "weave": {
    "transcript-cleanup": {
      "provider": "gemini",
      "prompt_file": "prompts/example.md"
    }
  },
  "out": {
    "example-journals": {
      "timezone": "America/Los_Angeles",
      "vault": {
        "_comment": "For a relative path, use relative_to 'cwd' or 'config'. For an absolute path or a path beginning with '~', omit relative_to.",
        "_comment_examples": [
          "CWD-relative: {\"path\": \"transcript-weaver-test-output\", \"relative_to\": \"cwd\"}",
          "Config-relative: {\"path\": \"transcript-weaver-test-output\", \"relative_to\": \"config\"}",
          "Absolute: {\"path\": \"/absolute/path/to/your/Obsidian/Vault\"}",
          "Home-relative: {\"path\": \"~/Obsidian/My Vault\"}"
        ],
        "path": "transcript-weaver-test-output",
        "relative_to": "cwd"
      },
      "packet_fields": {
        "category": "weave.type",
        "content": "weave.content"
      },
      "destinations": {
        "gratitude": {
          "operation": "insert",
          "file": "Gratitude Journal.md",
          "format": "## {date}\n\n{content}\n\n"
        },
        "dream": {
          "operation": "insert",
          "file": "Dream Journal.md",
          "format": "## {date}\n\n{content}\n\n"
        },
        "dss": {
          "operation": "insert",
          "file": "DSS Chronicles.md",
          "format": "## {date}\n\n{content}\n\n"
        },
        "sacred": {
          "operation": "insert",
          "file": "Sacred Journey Journal.md",
          "format": "## {date}\n\n{content}\n\n"
        },
        "unknown": {
          "operation": "create",
          "directory": "00 Inbox",
          "filename": "{date}-{time}-unknown.md",
          "format": "{content}\n"
        }
      }
    }
  }
}
